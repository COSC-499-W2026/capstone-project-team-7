# Local development only. Change these before using a shared/hosted database.
# Copy this file to .env; the real .env is ignored by Git.
# Docker uses these settings when initializing the database for the first time.
POSTGRES_DB=lost_in_translation
POSTGRES_USER=lit_app
POSTGRES_PASSWORD=lit_local_password
# Port exposed on your computer; PostgreSQL inside the container still uses 5432.
POSTGRES_PORT=5432
# Python connects using this URL. Keep its credentials, port and database in sync above.
DATABASE_URL=postgresql://lit_app:lit_local_password@localhost:5432/lost_in_translation
# Integration tests create and remove an isolated schema in this database.
TEST_DATABASE_URL=postgresql://lit_app:lit_local_password@localhost:5432/lost_in_translation
